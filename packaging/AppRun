#!/bin/sh
# Launch the real binary, not a root-level symlink: its loader/QML paths
# must be resolved from usr/bin, where qt.conf and prefix helpers live.
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR
# Prefer host libraries (e.g. a newer FFmpeg/libva matching the host's mesa)
# over the bundled ones, falling back to the bundle when the host lacks a
# compatible version. Host directories are listed first; the bundled dir is
# last-resort. libva, libvdpau, libvulkan, libOpenCL and libvpl are
# deliberately not bundled (see packaging) so they always resolve to the host's
# version and match the host's drivers.
export LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}:$APPDIR/usr/lib"
exec "$APPDIR/usr/bin/trophy" "$@"
