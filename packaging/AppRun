#!/bin/sh
# Launch the real binary, not a root-level symlink: its loader/QML paths
# must be resolved from usr/bin, where qt.conf and prefix helpers live.
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR

# The AppImage ships usr/share/applications/trophy.desktop. Putting the mount's
# data dirs first lets the desktop portal resolve Trophy's app id without
# installing anything, so capture approvals and global shortcuts belong to
# Trophy on every launch - even one started from another manager's entry.
# An explicit XDG_DATA_DIRS is preserved after it; the spec default is used
# when the variable was unset.
if [ -n "${XDG_DATA_DIRS:-}" ]; then
    export XDG_DATA_DIRS="$APPDIR/usr/share:$XDG_DATA_DIRS"
else
    export XDG_DATA_DIRS="$APPDIR/usr/share:/usr/local/share:/usr/share"
fi

# libva is the ONE library family taken from the host. The VA driver
# (radeonsi_drv_video.so, iHD_drv_video.so, ...) is a host object built against
# the host's libva, so a bundled older copy shadows it and breaks VA-API on
# newer GPUs. Everything else -- Qt, FFmpeg, codecs -- stays bundled so no host
# ABI can leak in (a host Qt 6.4 with the same soname as our 6.12 fails with
# "version `Qt_6.12' not found").
#
# Environment overrides, both optional:
#   TROPHY_PREFER_BUNDLED_LIBVA=1  ignore the host libva entirely
#   TROPHY_LIBVA_DIRS=<dir>[:...]  search these directories instead of ldconfig
#
# The override is a per-user directory of symlinks because APPDIR is a
# read-only squashfs mount. A shared /tmp path would let one user's directory
# block another's and would be a symlink-hijack target.

is_elf64() {
    # e_ident[EI_CLASS] == 2 (ELFCLASS64). Rejecting anything else keeps a
    # 32-bit multilib copy out of a 64-bit process; if this cannot be read the
    # library is rejected, which falls back to the bundled set.
    [ -f "$1" ] || return 1
    [ "$(od -An -t u1 -j 4 -N 1 "$1" 2>/dev/null | tr -d ' \n')" = "2" ]
}

find_libva_dir() {
    # Return the first directory holding a COMPLETE 64-bit libva set. All three
    # modules must come from one directory: FFmpeg 6's libavutil links libva-x11
    # and libva-drm as well, so mixing a host core with a bundled module (or two
    # host generations) would be a real ABI hazard.
    if [ -n "${TROPHY_LIBVA_DIRS:-}" ]; then
        candidates=$(printf '%s' "$TROPHY_LIBVA_DIRS" | tr ':' ' ')
    else
        candidates=$(ldconfig -p 2>/dev/null \
            | awk '$1 == "libva.so.2" { print $NF }' \
            | sed 's:/[^/]*$::')
        candidates="$candidates /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib"
    fi
    for dir in $candidates; do
        [ -d "$dir" ] || continue
        complete=1
        for lib in libva.so.2 libva-drm.so.2 libva-x11.so.2; do
            if ! is_elf64 "$dir/$lib"; then
                complete=0
                break
            fi
        done
        if [ "$complete" = 1 ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

VA_HOST_DIR=
if [ "${TROPHY_PREFER_BUNDLED_LIBVA:-0}" != "1" ]; then
    VA_HOST_DIR=$(find_libva_dir) || VA_HOST_DIR=
fi

VA_OVERRIDE=
if [ -n "$VA_HOST_DIR" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        candidate="$XDG_RUNTIME_DIR/trophy-va"
    else
        candidate="${TMPDIR:-/tmp}/trophy-va-$(id -u)"
    fi
    # Refuse a pre-existing symlink: mkdir would fail on it and a directory we
    # do not own could otherwise be adopted.
    if [ ! -L "$candidate" ] \
       && { mkdir -m 700 "$candidate" 2>/dev/null \
            || { [ -d "$candidate" ] \
                 && [ "$(stat -c %u "$candidate" 2>/dev/null)" = "$(id -u)" ]; }; }; then
        chmod 700 "$candidate" 2>/dev/null || true
        VA_OVERRIDE=$candidate
    fi
fi

if [ -n "$VA_OVERRIDE" ]; then
    # Publish each entry atomically (temp + rename) so a concurrently starting
    # instance never sees a half-built or momentarily empty directory, and
    # replace rather than append so stale targets from an earlier AppImage
    # version cannot linger.
    for lib in libva.so.2 libva-drm.so.2 libva-x11.so.2; do
        tmp="$VA_OVERRIDE/.$lib.$$"
        if ln -sfn "$VA_HOST_DIR/$lib" "$tmp" 2>/dev/null \
           && mv -f "$tmp" "$VA_OVERRIDE/$lib" 2>/dev/null; then
            :
        else
            rm -f "$tmp" 2>/dev/null || true
            VA_OVERRIDE=
            break
        fi
    done
    # A target that disappeared since the scan also disqualifies the override:
    # -e follows the symlink, so this detects it.
    if [ -n "$VA_OVERRIDE" ]; then
        for lib in libva.so.2 libva-drm.so.2 libva-x11.so.2; do
            [ -e "$VA_OVERRIDE/$lib" ] || { VA_OVERRIDE=; break; }
        done
    fi
fi

if [ -n "$VA_OVERRIDE" ]; then
    export LD_LIBRARY_PATH="$VA_OVERRIDE:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
    # No usable host libva (absent, incomplete, 32-bit or opted out): keep the
    # bundled copy so the app still starts. VA-API then reports unavailable
    # rather than the process dying of a missing library.
    export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$APPDIR/usr/bin/trophy" "$@"
