#!/bin/sh
# Diagnostic variant only; the release AppRun remains unchanged.
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR
# libva is the ONE library taken from the host: the VA driver is a host object
# built against the host's libva, so a bundled older copy shadows it and breaks
# VA-API on newer GPUs. Everything else stays bundled. The override is a
# per-user symlink directory so one user's copy cannot block another's.
find_host_lib() {
    lib=$1
    for p in $(ldconfig -p 2>/dev/null | awk -v n="$lib" '$1 == n { print $NF }') \
             "/usr/lib/x86_64-linux-gnu/$lib" "/usr/lib64/$lib" "/usr/lib/$lib"; do
        [ -f "$p" ] || continue
        cls=$(od -An -t u1 -j 4 -N 1 "$p" 2>/dev/null | tr -d ' \n')
        if [ "$cls" = "2" ]; then
            printf '%s\n' "$p"
            return 0
        fi
    done
    return 1
}

VA_OVERRIDE=
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
    candidate="$XDG_RUNTIME_DIR/trophy-va"
else
    candidate="${TMPDIR:-/tmp}/trophy-va-$(id -u)"
fi
if mkdir -m 700 "$candidate" 2>/dev/null \
   || { [ -d "$candidate" ] && [ "$(stat -c %u "$candidate" 2>/dev/null)" = "$(id -u)" ]; }; then
    VA_OVERRIDE=$candidate
    chmod 700 "$VA_OVERRIDE" 2>/dev/null || true
fi
if [ -n "$VA_OVERRIDE" ]; then
    # All three libva modules move together: FFmpeg 6's libavutil links
    # libva-x11 as well, so overriding only part of the set would mix a bundled
    # module with a host core.
    rm -f "$VA_OVERRIDE/libva.so.2" "$VA_OVERRIDE/libva-drm.so.2" \
          "$VA_OVERRIDE/libva-x11.so.2" 2>/dev/null || true
    for lib in libva.so.2 libva-drm.so.2 libva-x11.so.2; do
        path=$(find_host_lib "$lib") || path=
        if [ -n "$path" ]; then
            ln -sf "$path" "$VA_OVERRIDE/$lib" 2>/dev/null || true
        fi
    done
fi
if [ -n "$VA_OVERRIDE" ] && [ -n "$(ls -A "$VA_OVERRIDE" 2>/dev/null)" ]; then
    export LD_LIBRARY_PATH="$VA_OVERRIDE:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
    export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
case "${1:-}" in
    --trophy-test-inventory)
        cat "$APPDIR/usr/share/trophy/diagnostic-tests.json"
        exit 0
        ;;
    --trophy-test)
        shift
        name=${1:-}
        case "$name" in
            test_EncoderTest|test_DmaBufCudaImport|test_VaapiVideoProcessor|test_EglDisplayLease|test_Muxer|test_EncoderFactory|test_AudioEncoder|test_AudioDriftCorrector|test_FramePipeline|test_PipeWireVideoFormat|test_PipeWireBufferLease|test_PipeWireSyncWait|test_AudioMixer) ;;
            *) echo 'Unknown diagnostic test executable' >&2; exit 2 ;;
        esac
        shift
        exec "$APPDIR/usr/bin/$name" "$@"
        ;;
esac
exec "$APPDIR/usr/bin/trophy" "$@"
